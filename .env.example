# Local demonstration credentials only. Bind ports to loopback.
POSTGRES_PASSWORD=local-demo-db
API_TOKEN=local-demo-token
LLM_BACKEND=mock
OPENWEBUI_BASE_URL=https://ai.collant.ru
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=ai-support
LLM_TIMEOUT_SECONDS=60
# Bounded dialog context; long memory stores confirmed resolved-incident facts only.
MEMORY_MAX_MESSAGES=12
MEMORY_MAX_CHARS=12000
MEMORY_RETENTION_DAYS=90
SEED_DEMO_KNOWLEDGE=false
KNOWLEDGE_BACKEND=openwebui
# JSON arrays; only approved instruction collections, not all company knowledge.
OPENWEBUI_KNOWLEDGE_IDS=[]
KNOWLEDGE_MAX_CHARS=200000
KNOWLEDGE_MAX_FILE_BYTES=30000000
SUPPORT_EMAIL=support@example.invalid
NEXTCLOUD_BACKEND=mock
NEXTCLOUD_BASE_URL=
# Direct private chats with a normal service account. Use an app password.
# NEXTCLOUD_BACKEND=account; no webhook registration or incoming port required.
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_POLL_INTERVAL_SECONDS=3
NEXTCLOUD_BATCH_SIZE=100
NEXTCLOUD_BOT_SECRET=
NEXTCLOUD_ALLOWED_ROOMS=[]
# For native photo attachments: Nextcloud Files service user, invited to the same rooms.
# Use an app password, not the bot HMAC secret. Text-only mock needs neither.
NEXTCLOUD_FILES_USERNAME=
NEXTCLOUD_FILES_APP_PASSWORD=
# mailto prepares an employee-controlled draft; SMTP is not used in that mode.
# MAIL_BACKEND=mailto requires your actual SUPPORT_EMAIL above.
MAIL_BACKEND=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
INTEGRATION_TIMEOUT_SECONDS=20
